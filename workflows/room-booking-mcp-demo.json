      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst allowedActions = [\n  'check_availability',\n  'create_booking',\n  'list_bookings',\n  'reschedule_booking',\n  'cancel_booking'\n];\nconst action = String(body.action ?? 'check_availability');\n\nreturn [{\n  json: {\n    action,\n    validAction: allowedActions.includes(action),\n    userId: String(body.userId ?? 'demo-user'),\n    start: String(body.start ?? '2030-01-15T14:00:00-03:00'),\n    end: String(body.end ?? '2030-01-15T15:00:00-03:00'),\n    room: String(body.room ?? 'Demo Room A')\n  }\n}];"
      },
